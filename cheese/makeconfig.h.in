//////////////////////////////////////////////////////////
// CMake configuration options (generated by cmake)
//////////////////////////////////////////////////////////

#ifndef CHEESE_MAKECONFIG_H_
#define CHEESE_MAKECONFIG_H_

#include <string_view>

// define to use hardware popcount
#cmakedefine USE_POPCOUNT

// define to use PEXT instruction
#cmakedefine USE_PEXT

// Use syzygy tablebases
#cmakedefine USE_TABLEBASES

// project name and version
namespace Cheese {

	inline constexpr std::string_view project_ver = "@PROJECT_VERSION@";

	inline constexpr int project_ver_major = @PROJECT_VERSION_MAJOR@;
	inline constexpr int project_ver_minor = @PROJECT_VERSION_MINOR@;
	inline constexpr int project_ver_patch = @PROJECT_VERSION_PATCH@;

} // namespace Cheese

#endif //CHEESE_MAKECONFIG_H_

